# DO NOT SHARE THIS FILE

# Discord Bot Configuration
# [REQUIRED] Your Discord Bot Token (https://discord.com/developers/applications)
BOT_TOKEN=your_token_here_do_not_share

# [OPTIONAL] Command prefixes, separated by commas if multiple
# Example: !, ?, bot!
BOT_PREFIXES=your_bot_prefixes

# API Keys
# [REQUIRED] External API Key for XYZ service
API_KEY=your_api_key_here

# [ETERNAL RETURN API KEY] Used for accessing Nimble Neuron's Eternal Return game developer API and player stats
ER_API_KEY=your_er_api_key_here

# [HENRIK DEV API KEY] Used for unofficial Valorant developer API services (match history, leaderboards, stats)
HENRIK_API_KEY=your_henrik_api_key_here

# [MINECRAFT API KEY] Used for authenticating or querying Minecraft services, player profiles, or server status APIs
MC_API_KEY=yout_mc_api_key_here

# [PUBG API KEY] Used for accessing official PUBG (PlayerUnknown's Battlegrounds) developer stats and match data
PUBG_API_KEY=your_pubg_api_key_here

# [RIOT GAMES API KEY] Used for accessing Riot Games API (League of Legends, Valorant, Teamfight Tactics, etc.)
RIOT_API_KEY=your_riot_api_key_here